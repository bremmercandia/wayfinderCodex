VITE_ENTER_ANALYTICS_ENABLED=true
VITE_ENTER_ANALYTICS_TOKEN=
VITE_ENTER_PROJECT_ID=
VITE_ENTER_ANALYTICS_ENDPOINT=https://api.enter.pro
VITE_ENTER_ANALYTICS_DEFINITIONS_ENDPOINT=
VITE_ENTER_ANALYTICS_DEBUG=false

# ---------------------------------------------------------------------------
# WayfinderCodex game data (public values only - never put a secret here)
# ---------------------------------------------------------------------------
# Blizzard namespace for the Classic data. Swap these for the WoW Forever
# namespaces the moment they are published; no code change is required.
VITE_BLIZZARD_NAMESPACE=static-classic-us
VITE_BLIZZARD_REGION=us
VITE_BLIZZARD_LOCALE=en_US
# Absolute URL of a server-side proxy that holds the Blizzard client credentials.
# Leave empty for curated/static mode: the app then makes no API requests at all.
VITE_BLIZZARD_API_BASE=
# Wowhead domain used for item/quest/NPC tooltips: classic | tbc | wotlk
VITE_WOWHEAD_DOMAIN=classic